# URL base da API de back-end.
# Se omitido o protocolo, o api.ts assume "https://" automaticamente.
# Se a variável não for definida, o api.ts utiliza a URL de homologação como fallback.
REACT_APP_URL_API=homolog-api.seudominio.com

# Modo mock (ver CLAUDE.md e src/mocks/): "true" troca toda chamada de api.ts por dados
# simulados em memória (src/mocks/apiMock.ts), sem precisar de back-end no ar. "false" (ou
# ausente) usa a API real configurada acima. Credenciais de demonstração em
# src/mocks/bancoMock.ts (ex: solicitante@demo.com / 123456).
VITE_USE_MOCKS=true
